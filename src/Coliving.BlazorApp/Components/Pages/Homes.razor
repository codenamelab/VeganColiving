@page "/homes"
@rendermode InteractiveServer

@using Coliving.BlazorApp.Data
@using Coliving.BlazorApp.Models
@using Coliving.BlazorApp.Models.Matrix.Core.Models
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore;

<PageTitle>Potential Homes</PageTitle>

<h1>Potential Homes</h1>

@if (flats == null)
{
    <div class="text-center">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p>Loading potential homes...</p>
    </div>
}
else if (!flats.Any())
{
    <div class="alert alert-info">
        <h4>No potential homes found</h4>
        <p>Check back later for new listings!</p>
    </div>
}
else
{
    <div class="row">
        @foreach (var flat in flats)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100">
                    @{
                        var imgUrl = GetFlatImageUrl(flat);
                    }
                    @if (!string.IsNullOrEmpty(imgUrl))
                    {
                        <img src="@imgUrl" class="card-img-top" alt="@flat.Title" style="object-fit:cover; max-height:180px;" />
                    }
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@flat.Title</h5>
                        <p class="card-text">@flat.Description</p>
                        <p class="card-text">
                            <i class="bi bi-geo-alt"></i>
                            @flat.City, @flat.Country
                        </p>
                        <p class="card-text">
                            <strong>Price:</strong> @flat.PricePerMonth.ToString("C")
                        </p>
                        <div class="mt-auto">
                            <a class="btn btn-outline-primary btn-sm" href="/homes/@flat.Id">View details</a>
                        </div>
                        <AuthorizeView>
                            <Authorized>
                                <div class="d-flex gap-2 mt-2">
                                    <button class="btn @GetInterestedBtnClass(flat.Id) btn-sm" @onclick="() => SetEngagement(flat.Id, EngagementStatus.Interested)" disabled="@IsStatus(flat.Id, EngagementStatus.Interested)">
                                        <i class="bi bi-heart"></i> Interested
                                    </button>
                                    <button class="btn @GetCommittedBtnClass(flat.Id) btn-sm" @onclick="() => SetEngagement(flat.Id, EngagementStatus.Committed)" disabled="@IsStatus(flat.Id, EngagementStatus.Committed)">
                                        <i class="bi bi-check2-circle"></i> Committed
                                    </button>
                                    @if (IsStatusSet(flat.Id))
                                    {
                                        <button class="btn btn-outline-secondary btn-sm" title="Clear selection" @onclick="() => ClearEngagement(flat.Id)">
                                            <i class="bi bi-x-circle"></i>
                                        </button>
                                    }
                                </div>
                                @if (engagements.TryGetValue(flat.Id, out var status) && status != EngagementStatus.None)
                                {
                                    <div class="mt-2 small text-muted">
                                        Your status: <strong>@status</strong>
                                    </div>
                                }
                                <div class="mt-3">
                                    <div class="small mb-1">
                                        <i class="bi bi-heart text-danger"></i>
                                        <strong>Interested</strong>
                                        @if (interestedUsersByFlat.TryGetValue(flat.Id, out var intUsers) && intUsers.Count > 0)
                                        {
                                            <span class="text-muted">(@intUsers.Count)</span>
                                        }
                                    </div>
                                    @RenderUserList(flat.Id, interestedUsersByFlat)
                                    <div class="small mt-2 mb-1">
                                        <i class="bi bi-check2-circle text-primary"></i>
                                        <strong>Committed</strong>
                                        @if (committedUsersByFlat.TryGetValue(flat.Id, out var comUsers) && comUsers.Count > 0)
                                        {
                                            <span class="text-muted">(@comUsers.Count)</span>
                                        }
                                    </div>
                                    @RenderUserList(flat.Id, committedUsersByFlat)
                                </div>
                            </Authorized>
                            <NotAuthorized>
                                <div class="mt-2 small text-muted">Sign in to mark interest or commitment.</div>
                            </NotAuthorized>
                        </AuthorizeView>
                    </div>
                    <div class="card-footer text-muted">
                        <small>Listed: @flat.DateListed.ToShortDateString()</small>
                    </div>
                </div>
            </div>
        }
    </div>


}