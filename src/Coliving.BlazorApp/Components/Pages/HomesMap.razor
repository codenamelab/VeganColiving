@page "/homes/map"
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@rendermode InteractiveServer
@using Coliving.BlazorApp.Data
@using Coliving.BlazorApp.Models
@using Microsoft.JSInterop
@using Microsoft.EntityFrameworkCore
@inject ColivingDbContext Db
@inject IJSRuntime JS

<div id="map" style="height:70vh;border-radius:12px;box-shadow:var(--shadow-soft);"></div>

@if (homes is null)
{
    <p>Loading homes…</p>
}
else if (homes.Count == 0)
{
    <p>No homes found.</p>
}

@code {
    private List<Home>? homes; // null until loaded
    private bool mapReady;
    private bool plotted;

    protected override async Task OnInitializedAsync()
    {
        homes = await Db.Homes
            .OrderByDescending(f => f.DateListed)
            .ToListAsync();
        // Trigger re-render so OnAfterRenderAsync runs again to plot
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Initialize map centered on Oslo
            mapReady = await JS.InvokeAsync<bool>("FlatsMap.init", new { elementId = "map", center = new[] { 59.9139, 10.7522 }, zoom = 12 });
        }

        // Plot when data is available and not yet plotted
        if (mapReady && !plotted && homes is not null && homes.Count > 0)
        {
            var points = homes.Select(f => new
            {
                id = f.Id,
                title = f.Title,
                address = f.Address,
                city = f.City,
                country = f.Country,
                price = (double)f.PricePerMonth,
                imageUrl = !string.IsNullOrWhiteSpace(f.ImageUrl)
                    ? f.ImageUrl
                    : (f.ImageBytes != null && f.ImageBytes.Length > 0 ? $"/api/homes/{f.Id}/image" : null)
            }).ToList();

            await JS.InvokeVoidAsync("FlatsMap.plot", points); // JS function name kept for now
            plotted = true;
        }
    }

    private sealed class HomePoint
    {
        public int Id { get; set; }
        public string Title { get; set; } = string.Empty;
        public string? Address { get; set; }
        public string? City { get; set; }
        public string? Country { get; set; }
        public double Price { get; set; }
        public string? ImageUrl { get; set; }
    }
}
