@page "/homes/{id:int}"
@rendermode InteractiveServer

@using Coliving.BlazorApp.Models
@using Microsoft.EntityFrameworkCore
@inject NavigationManager Nav

<PageTitle>Home Details</PageTitle>

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger" role="alert">@error</div>
}
else if (home is null)
{
    <div class="text-center">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p>Loading home...</p>
    </div>
}
else
{
    <div class="container py-3">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <a class="btn btn-link" href="/homes">? Back to homes</a>
            <AuthorizeView>
                <Authorized>
                    <a class="btn btn-outline-secondary btn-sm" href="/homes/@home.Id/edit">
                        <i class="bi bi-pencil-square"></i> Edit
                    </a>
                </Authorized>
            </AuthorizeView>
        </div>

        <div class="row g-3">
            <div class="col-12 col-lg-6">
                @if (home.Images != null && home.Images.Any())
                {
                    <div class="mb-3">
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var img in home.Images)
                            {
                                <img src="@($"/api/images/{img.Id}")" alt="@img.Title" class="img-thumbnail" style="max-width: 180px; max-height: 180px; object-fit:cover;" />
                            }
                        </div>
                    </div>
                }
                else if (!string.IsNullOrEmpty(ImageUrl))
                {
                    <img src="@ImageUrl" alt="@home.Title" class="img-fluid rounded" style="object-fit:cover; max-height:400px; width:100%;" />
                }
            </div>
            <div class="col-12 col-lg-6">
                <h2 class="mb-2">@home.Title</h2>
                <p class="text-muted mb-1">
                    <i class="bi bi-geo-alt"></i>
                    @home.Address, @home.City, @home.Country
                </p>
                <p class="mb-2"><strong>Type:</strong> @home.Type</p>
                <p class="mb-2"><strong>Capacity:</strong> @home.Capacity</p>
                <p class="mb-2"><strong>Price per month:</strong> @home.PricePerMonth.ToString("C")</p>
                <p class="text-muted"><small>Listed: @home.DateListed.ToShortDateString()</small></p>

                @if (!string.IsNullOrWhiteSpace(home.Description))
                {
                    <div class="mt-3">
                        <h5>Description</h5>
                        <p>@home.Description</p>
                    </div>
                }

                @if (home.ExternalUrls is not null && home.ExternalUrls.Any())
                {
                    <div class="mt-3">
                        <h5>External Links</h5>
                        <ul class="list-unstyled">
                            @foreach (var link in home.ExternalUrls.OrderByDescending(e => e.CreatedUtc))
                            {
                                <li class="mb-1">
                                    <a href="@link.Url" target="_blank" rel="noopener noreferrer">
                                        <i class="bi bi-box-arrow-up-right"></i> @link.Source
                                    </a>
                                    @if (!string.IsNullOrWhiteSpace(link.Notes))
                                    {
                                        <small class="text-muted"> - @link.Notes</small>
                                    }
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>
        </div>

        @if (home.Rooms != null && home.Rooms.Any())
        {
            <div class="mt-4">
                <h4>Rooms</h4>
                <div class="row g-3">
                    @foreach (var room in home.Rooms!)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="card h-100">
                                @if (!string.IsNullOrWhiteSpace(room.ImageUrl))
                                {
                                    <img src="@room.ImageUrl" class="card-img-top" alt="@room.Title" style="object-fit:cover; max-height:180px;" />
                                }
                                <div class="card-body">
                                    <h5 class="card-title">@room.Title</h5>
                                    <p class="card-text">@room.Description</p>
                                    <p class="card-text"><strong>Price:</strong> @room.PricePerMonth.ToString("C")</p>
                                    @if (room.SizeSqm is not null)
                                    {
                                        <p class="card-text"><strong>Size:</strong> @room.SizeSqm m²</p>
                                    }
                                    <span class="badge @(room.IsAvailable ? "text-bg-success" : "text-bg-secondary")">
                                        @(room.IsAvailable ? "Available" : "Unavailable")
                                    </span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}

