@page "/homes/{id:int}"
@rendermode InteractiveServer

@using Coliving.BlazorApp.Models
@using Microsoft.EntityFrameworkCore
@inject NavigationManager Nav

<PageTitle>Home Details</PageTitle>

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger" role="alert">@error</div>
}
else if (flat is null)
{
    <div class="text-center">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p>Loading home...</p>
    </div>
}
else
{
    <div class="container py-3">
        <a class="btn btn-link mb-3" href="/homes">? Back to homes</a>

        <div class="row g-3">
            <div class="col-12 col-lg-6">
                @if (!string.IsNullOrEmpty(ImageUrl))
                {
                    <img src="@ImageUrl" alt="@flat.Title" class="img-fluid rounded" style="object-fit:cover; max-height:400px; width:100%;" />
                }
            </div>
            <div class="col-12 col-lg-6">
                <h2 class="mb-2">@flat.Title</h2>
                <p class="text-muted mb-1">
                    <i class="bi bi-geo-alt"></i>
                    @flat.Address, @flat.City, @flat.Country
                </p>
                <p class="mb-2"><strong>Type:</strong> @flat.Type</p>
                <p class="mb-2"><strong>Capacity:</strong> @flat.Capacity</p>
                <p class="mb-2"><strong>Price per month:</strong> @flat.PricePerMonth.ToString("C")</p>
                <p class="text-muted"><small>Listed: @flat.DateListed.ToShortDateString()</small></p>

                @if (!string.IsNullOrWhiteSpace(flat.Description))
                {
                    <div class="mt-3">
                        <h5>Description</h5>
                        <p>@flat.Description</p>
                    </div>
                }
            </div>
        </div>

        @if (flat.Rooms != null && flat.Rooms.Any())
        {
            <div class="mt-4">
                <h4>Rooms</h4>
                <div class="row g-3">
                    @foreach (var room in flat.Rooms!)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="card h-100">
                                @if (!string.IsNullOrWhiteSpace(room.ImageUrl))
                                {
                                    <img src="@room.ImageUrl" class="card-img-top" alt="@room.Title" style="object-fit:cover; max-height:180px;" />
                                }
                                <div class="card-body">
                                    <h5 class="card-title">@room.Title</h5>
                                    <p class="card-text">@room.Description</p>
                                    <p class="card-text"><strong>Price:</strong> @room.PricePerMonth.ToString("C")</p>
                                    @if (room.SizeSqm is not null)
                                    {
                                        <p class="card-text"><strong>Size:</strong> @room.SizeSqm m²</p>
                                    }
                                    <span class="badge @(room.IsAvailable ? "text-bg-success" : "text-bg-secondary")">
                                        @(room.IsAvailable ? "Available" : "Unavailable")
                                    </span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}

