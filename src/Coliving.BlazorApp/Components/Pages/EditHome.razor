@page "/homes/{id:int}/edit"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using Coliving.BlazorApp.Models
@using Microsoft.AspNetCore.Components.Forms
@using Coliving.BlazorApp.Data
@using Microsoft.EntityFrameworkCore
@using System
@using System.IO

@attribute [Authorize]

<PageTitle>Edit Home</PageTitle>

<h1>Edit Home</h1>

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger" role="alert">@error</div>
}
else if (existingHome is null)
{
    <div class="text-center">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p>Loading home...</p>
    </div>
}
else
{
    <EditForm Model="@existingHome" OnValidSubmit="@HandleValidSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Title</label>
                <InputText class="form-control" @bind-Value="existingHome.Title" />
                <ValidationMessage For="@(() => existingHome.Title)" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Type</label>
                <InputText class="form-control" @bind-Value="existingHome.Type" placeholder="Apartment, House, Room" />
                <ValidationMessage For="@(() => existingHome.Type)" />
            </div>

            <div class="col-12">
                <label class="form-label">Description</label>
                <InputTextArea class="form-control" @bind-Value="existingHome.Description" rows="4" />
                <ValidationMessage For="@(() => existingHome.Description)" />
            </div>

            <div class="col-md-6">
                <label class="form-label">City</label>
                <InputText class="form-control" @bind-Value="existingHome.City" />
                <ValidationMessage For="@(() => existingHome.City)" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Country</label>
                <InputText class="form-control" @bind-Value="existingHome.Country" />
                <ValidationMessage For="@(() => existingHome.Country)" />
            </div>

            <div class="col-12">
                <label class="form-label">Address</label>
                <InputText class="form-control" @bind-Value="existingHome.Address" />
                <ValidationMessage For="@(() => existingHome.Address)" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Price per month</label>
                <InputNumber class="form-control" @bind-Value="existingHome.PricePerMonth" />
                <ValidationMessage For="@(() => existingHome.PricePerMonth)" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Capacity</label>
                <InputNumber class="form-control" @bind-Value="existingHome.Capacity" />
                <ValidationMessage For="@(() => existingHome.Capacity)" />
            </div>

            <div class="col-12">
                <label class="form-label">Primary image URL</label>
                <InputText class="form-control" @bind-Value="existingHome.ImageUrl" />
                <ValidationMessage For="@(() => existingHome.ImageUrl)" />
            </div>

            <div class="col-12">
                <label class="form-label">Or upload a new primary image</label>
                <InputFile OnChange="OnImageSelected" accept="image/*" />
                @if (!string.IsNullOrEmpty(imagePreviewDataUrl))
                {
                    <div class="mt-2">
                        <img src="@imagePreviewDataUrl" alt="Preview" style="max-width: 320px; max-height: 240px; border-radius:8px; box-shadow: var(--shadow-soft);" />
                        <div class="mt-2 d-flex gap-2">
                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="ClearImage">Remove uploaded image</button>
                            @if (!string.IsNullOrEmpty(originalImageUrl))
                            {
                                <a class="btn btn-sm btn-outline-secondary" href="@originalImageUrl" target="_blank">View current image</a>
                            }
                        </div>
                    </div>
                }
                else if (!string.IsNullOrEmpty(originalImageUrl))
                {
                    <div class="mt-2">
                        <img src="@originalImageUrl" alt="Current image" style="max-width: 320px; max-height: 240px; border-radius:8px; box-shadow: var(--shadow-soft);" />
                    </div>
                }
            </div>

            <div class="col-12">
                <label class="form-label">Add more images (up to 10)</label>
                <InputFile OnChange="OnAdditionalImagesSelected" multiple accept="image/*" />
                @if (additionalImagePreviews.Count > 0)
                {
                    <div class="mt-2 d-flex flex-wrap gap-2">
                        @foreach (var preview in additionalImagePreviews)
                        {
                            <img src="@preview" alt="Additional image" class="img-thumbnail" style="max-width: 140px; max-height: 140px; object-fit:cover;" />
                        }
                    </div>
                    <div class="mt-2">
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ClearAdditionalImages">Clear additional images</button>
                    </div>
                }

                @if (existingHome.Images is not null && existingHome.Images.Any())
                {
                    <div class="mt-3">
                        <div class="small text-muted mb-1">Current images</div>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var img in existingHome.Images)
                            {
                                <img src="@($"/api/images/{img.Id}")" alt="@img.Title" class="img-thumbnail" style="max-width: 140px; max-height: 140px; object-fit:cover;" />
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="col-12 mt-4">
                <h5>External links</h5>
                <p class="text-muted small mb-2">Add or update links to listings on other platforms (e.g. Airbnb, Booking) or a personal website.</p>
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr>
                                <th style="width:15%">Source</th>
                                <th style="width:45%">URL</th>
                                <th style="width:30%">Notes</th>
                                <th style="width:10%"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < externalUrls.Count; i++)
                            {
                                var idx = i;
                                <tr>
                                    <td>
                                        <InputText class="form-control form-control-sm" @bind-Value="externalUrls[idx].Source" placeholder="Airbnb" />
                                    </td>
                                    <td>
                                        <InputText class="form-control form-control-sm" @bind-Value="externalUrls[idx].Url" placeholder="https://..." />
                                    </td>
                                    <td>
                                        <InputText class="form-control form-control-sm" @bind-Value="externalUrls[idx].Notes" placeholder="Optional" />
                                    </td>
                                    <td class="text-end">
                                        <button type="button" class="btn btn-outline-danger btn-sm" title="Remove" @onclick="(() => RemoveExternalUrl(idx))" disabled="@(externalUrls.Count == 1)">?</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AddExternalUrl">Add link</button>
            </div>
        </div>

        <div class="mt-4 d-flex gap-2 align-items-start">
            <button type="submit" class="btn btn-primary">Save changes</button>
            <a href="/homes/@id" class="btn btn-secondary">Cancel</a>
            <button type="button" class="btn btn-outline-danger" @onclick="() => showDeleteConfirm = true">Delete home</button>
        </div>

        @if (showDeleteConfirm)
        {
            <div class="alert alert-warning mt-3" role="alert">
                <div class="fw-bold mb-2">Delete this home?</div>
                <p class="mb-2">This action cannot be undone. All related rooms, images, and engagements will also be deleted.</p>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-danger" @onclick="DeleteHomeAsync">Yes, delete</button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="() => showDeleteConfirm = false">Cancel</button>
                </div>
            </div>
        }
    </EditForm>
}