@page "/homes/register"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using Coliving.BlazorApp.Models
@using Microsoft.AspNetCore.Components.Forms

@attribute [Authorize]

<PageTitle>Register Home</PageTitle>

<h1>Register a Home</h1>

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger" role="alert">@error</div>
}

<EditForm Model="@newFlat" OnValidSubmit="@HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label">Title</label>
            <InputText class="form-control" @bind-Value="newFlat.Title" />
            <ValidationMessage For="@(() => newFlat.Title)" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Type</label>
            <InputText class="form-control" @bind-Value="newFlat.Type" placeholder="Apartment, House, Room" />
            <ValidationMessage For="@(() => newFlat.Type)" />
        </div>

        <div class="col-12">
            <label class="form-label">Description</label>
            <InputTextArea class="form-control" @bind-Value="newFlat.Description" rows="4" />
            <ValidationMessage For="@(() => newFlat.Description)" />
        </div>

        <div class="col-md-6">
            <label class="form-label">City</label>
            <InputText class="form-control" @bind-Value="newFlat.City" />
            <ValidationMessage For="@(() => newFlat.City)" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Country</label>
            <InputText class="form-control" @bind-Value="newFlat.Country" />
            <ValidationMessage For="@(() => newFlat.Country)" />
        </div>

        <div class="col-12">
            <label class="form-label">Address</label>
            <InputText class="form-control" @bind-Value="newFlat.Address" />
            <ValidationMessage For="@(() => newFlat.Address)" />
        </div>

        <div class="col-md-6">
            <label class="form-label">Price per month</label>
            <InputNumber class="form-control" @bind-Value="newFlat.PricePerMonth" />
            <ValidationMessage For="@(() => newFlat.PricePerMonth)" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Capacity</label>
            <InputNumber class="form-control" @bind-Value="newFlat.Capacity" />
            <ValidationMessage For="@(() => newFlat.Capacity)" />
        </div>

        <div class="col-12">
            <label class="form-label">Image URL</label>
            <InputText class="form-control" @bind-Value="newFlat.ImageUrl" />
            <ValidationMessage For="@(() => newFlat.ImageUrl)" />
        </div>

        <div class="col-12">
            <label class="form-label">Or upload an image</label>
            <InputFile OnChange="OnImageSelected" accept="image/*" />
            @if (!string.IsNullOrEmpty(imagePreviewDataUrl))
            {
                <div class="mt-2">
                    <img src="@imagePreviewDataUrl" alt="Preview" style="max-width: 320px; max-height: 240px; border-radius:8px; box-shadow: var(--shadow-soft);" />
                    <div class="mt-2">
                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="ClearImage">Remove uploaded image</button>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Save</button>
        <a href="/flats" class="btn btn-secondary">Cancel</a>
    </div>
</EditForm>
