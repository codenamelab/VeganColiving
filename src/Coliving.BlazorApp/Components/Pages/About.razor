@page "/about"

<PageTitle>About</PageTitle>

<h1>About</h1>
<p>
    This app helps the vegan coliving community connect, discover homes, and build a kind and sustainable network.
</p>

<h2>What you can do</h2>
<ul>
    <li>Explore potential flats and view them on a map</li>
    <li>Register a home to share with the community</li>
    <li>Join and manage your profile to connect with others</li>
</ul>

<p class="text-muted small">
    Version @typeof(Program).Assembly.GetName().Version
</p>
