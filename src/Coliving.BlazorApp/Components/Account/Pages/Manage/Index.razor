@page "/Account/Manage"

@using System.ComponentModel.DataAnnotations
@using Coliving.BlazorApp.Models.Matrix.Core.Models
@using Microsoft.AspNetCore.Identity
@using Coliving.BlazorApp.Data

<PageTitle>Profile</PageTitle>

<h3>Profile</h3>
<StatusMessage />

<div class="row">
    <div class="col-xl-6">
        <EditForm Model="Input" FormName="profile" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />
            <div class="form-floating mb-3">
                <input type="text" value="@username" id="username" class="form-control" placeholder="Choose your username." disabled />
                <label for="username" class="form-label">Username</label>
            </div>
            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.PhoneNumber" id="Input.PhoneNumber" class="form-control" placeholder="Enter your phone number" />
                <label for="Input.PhoneNumber" class="form-label">Phone number</label>
                <ValidationMessage For="() => Input.PhoneNumber" class="text-danger" />
            </div>
            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.FirstName" id="Input.FirstName" class="form-control" placeholder="First name" />
                <label for="Input.FirstName" class="form-label">First name</label>
                <ValidationMessage For="() => Input.FirstName" class="text-danger" />
            </div>
            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.LastName" id="Input.LastName" class="form-control" placeholder="Last name" />
                <label for="Input.LastName" class="form-label">Last name</label>
                <ValidationMessage For="() => Input.LastName" class="text-danger" />
            </div>
            <div class="form-floating mb-3">
                <InputDate @bind-Value="Input.DateOfBirth" id="Input.DateOfBirth" class="form-control" />
                <label for="Input.DateOfBirth" class="form-label">Date of birth</label>
                <ValidationMessage For="() => Input.DateOfBirth" class="text-danger" />
            </div>
            <div class="form-floating mb-3">
                <InputNumber @bind-Value="Input.Points" id="Input.Points" class="form-control" />
                <label for="Input.Points" class="form-label">Points</label>
                <ValidationMessage For="() => Input.Points" class="text-danger" />
            </div>
            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.Name" id="Input.Name" class="form-control" placeholder="Display name" />
                <label for="Input.Name" class="form-label">Display name</label>
                <ValidationMessage For="() => Input.Name" class="text-danger" />
            </div>

            <h5 class="mt-4">Address</h5>
            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.Street" id="Input.Street" class="form-control" placeholder="Street" />
                <label for="Input.Street" class="form-label">Street</label>
                <ValidationMessage For="() => Input.Street" class="text-danger" />
            </div>
            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.City" id="Input.City" class="form-control" placeholder="City" />
                <label for="Input.City" class="form-label">City</label>
                <ValidationMessage For="() => Input.City" class="text-danger" />
            </div>
            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.State" id="Input.State" class="form-control" placeholder="State" />
                <label for="Input.State" class="form-label">State</label>
                <ValidationMessage For="() => Input.State" class="text-danger" />
            </div>
            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.Country" id="Input.Country" class="form-control" placeholder="Country" />
                <label for="Input.Country" class="form-label">Country</label>
                <ValidationMessage For="() => Input.Country" class="text-danger" />
            </div>
            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.ZipCode" id="Input.ZipCode" class="form-control" placeholder="Zip code" />
                <label for="Input.ZipCode" class="form-label">Zip code</label>
                <ValidationMessage For="() => Input.ZipCode" class="text-danger" />
            </div>

            <h5 class="mt-4">Payment</h5>
            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.CardHolderName" id="Input.CardHolderName" class="form-control" placeholder="Card holder name" />
                <label for="Input.CardHolderName" class="form-label">Card holder name</label>
                <ValidationMessage For="() => Input.CardHolderName" class="text-danger" />
            </div>
            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.CardNumber" id="Input.CardNumber" class="form-control" placeholder="Card number" />
                <label for="Input.CardNumber" class="form-label">Card number</label>
                <ValidationMessage For="() => Input.CardNumber" class="text-danger" />
            </div>
            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.SecurityNumber" id="Input.SecurityNumber" type="password" class="form-control" placeholder="Security number (CVV)" />
                <label for="Input.SecurityNumber" class="form-label">Security number (CVV)</label>
                <ValidationMessage For="() => Input.SecurityNumber" class="text-danger" />
            </div>
            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.Expiration" id="Input.Expiration" class="form-control" placeholder="MM/YY" />
                <label for="Input.Expiration" class="form-label">Expiration (MM/YY)</label>
                <ValidationMessage For="() => Input.Expiration" class="text-danger" />
            </div>
            <div class="form-floating mb-3">
                <InputNumber @bind-Value="Input.CardType" id="Input.CardType" class="form-control" />
                <label for="Input.CardType" class="form-label">Card type</label>
                <ValidationMessage For="() => Input.CardType" class="text-danger" />
            </div>

            <div class="form-check form-switch mb-4">
                <InputCheckbox @bind-Value="Input.IsColivingUser" id="Input.IsColivingUser" class="form-check-input" />
                <label for="Input.IsColivingUser" class="form-check-label">Is Coliving user</label>
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">Save</button>
        </EditForm>
    </div>
</div>
